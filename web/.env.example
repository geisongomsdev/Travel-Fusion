# O front NÃO fala com a Travelfusion — ele fala com a nossa API, pelo proxy do
# Vite (ver vite.config.js). Nenhuma credencial de provedor entra aqui.
#
# 🔴 Só variáveis com o prefixo VITE_ chegam ao navegador, e elas vão para dentro
# do bundle, em texto puro. Nunca coloque segredo numa VITE_*.

# Para onde o proxy /api aponta em desenvolvimento.
VITE_API_TARGET=http://localhost:3010
