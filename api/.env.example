PORT=3010

# ─── Travelfusion — Direct Connect XML API ───────────────────────────────────
#
# Produção. As credenciais só respondem a partir de IP whitelistado; sem isso a
# busca volta `4-3448 Login ID not found`.
TF_ENDPOINT=https://api.travelfusion.com/Xml
TF_XML_LOGIN_ID=passapi
TF_PASSWORD=troque-aqui

# Para rodar SEM credencial, contra o mock local (`npm run mock`):
#   TF_ENDPOINT=http://localhost:3999/Xml
#
# Deixar TF_PASSWORD com o valor de exemplo apontando para produção faz a API
# responder 401 PROVIDER_AUTHENTICATION_FAILED antes de sair para a rede.

# ─── Custom parameters obrigatórios em TODA request ──────────────────────────
# Key Integration Highlights §4. Ausência reprova na auditoria de go-live.
TF_REQUEST_ORIGIN=pass-br
TF_POINT_OF_SALE=BR
TF_USER_DATA=pass-flight-api

# ─── Busca ───────────────────────────────────────────────────────────────────
# O intervalo mínimo de 2s é regra da Travelfusion, não escolha nossa.
TF_ROUTING_POLL_INTERVAL_MS=2000
TF_ROUTING_CUTOFF_MS=40000

# ─── Provedores habilitados ──────────────────────────────────────────────────
# Ordem importa: é a ordem do evento `start` e o primeiro é o padrão de quem não
# escolhe. Tirar um daqui o desliga sem deploy — útil enquanto o IP da
# Travelfusion não está whitelistado.
PROVIDERS=latam,travelfusion

# ─── LATAM NDC v19.2 (Apigee) ────────────────────────────────────────────────
#
# Key/Secret saem do app que VOCÊ registra no portal, sem esperar ninguém:
#   Apps > + NEW APP > adicione a API "NDC v19.2 - Dev" > copie Key e Secret.
# Não há whitelist de IP aqui. App de PRODUÇÃO passa por aprovação da LATAM.
LATAM_ENDPOINT=https://sandbox.api.latam.com/api/ndc/v192
LATAM_TOKEN_ENDPOINT=https://sandbox.api.latam.com/oauth/cc/token
LATAM_API_KEY=troque-aqui
LATAM_API_SECRET=troque-aqui

# Headers X-latam-* obrigatórios em toda chamada.
LATAM_CLIENT_NAME=Pass
LATAM_APPLICATION_NAME=Pass-Dev
LATAM_COUNTRY=BR
LATAM_LANG=PT
LATAM_API_VERSION=V2

# Identificação da agência no corpo do AirShopping. Peça ao contato da LATAM.
LATAM_AGENCY_ID=
LATAM_AGENCY_IATA=
LATAM_AGENCY_NAME=Pass

# O token vive 59 min; renovamos antes para não perder busca por token vencido.
LATAM_TOKEN_TTL_MS=3300000

# Sem LATAM_API_KEY/SECRET a API responde 401 PROVIDER_AUTHENTICATION_FAILED
# ANTES de sair para a rede, com a mensagem dizendo o que fazer. Nao existe
# modo mock: o duble do NDC vive em test/fixtures e so o teste o alcanca.
