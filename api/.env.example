PORT=3010

# ─── Travelfusion — Direct Connect XML API ───────────────────────────────────
#
# Produção. As credenciais só respondem a partir de IP whitelistado; sem isso a
# busca volta `4-3448 Login ID not found`.
TF_ENDPOINT=https://api.travelfusion.com/Xml
TF_XML_LOGIN_ID=passapi
TF_PASSWORD=troque-aqui

# Para rodar SEM credencial, contra o mock local (`npm run mock`):
#   TF_ENDPOINT=http://localhost:3999/Xml
#
# Deixar TF_PASSWORD com o valor de exemplo apontando para produção faz a API
# responder 401 PROVIDER_AUTHENTICATION_FAILED antes de sair para a rede.

# ─── Custom parameters obrigatórios em TODA request ──────────────────────────
# Key Integration Highlights §4. Ausência reprova na auditoria de go-live.
TF_REQUEST_ORIGIN=pass-br
TF_POINT_OF_SALE=BR
TF_USER_DATA=pass-flight-api

# ─── Busca ───────────────────────────────────────────────────────────────────
# O intervalo mínimo de 2s é regra da Travelfusion, não escolha nossa.
TF_ROUTING_POLL_INTERVAL_MS=2000
TF_ROUTING_CUTOFF_MS=40000
